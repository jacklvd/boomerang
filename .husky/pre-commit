#!/bin/sh
# Repo-wide pre-commit dispatcher.
#
# dev-note: this lives at the repo root, not in client/, because git allows exactly one
# core.hooksPath. When it was client/.husky the server could never have a hook — husky
# would have pointed git at the client's directory and any .git/hooks/pre-commit written
# for the server would have been silently ignored. Each workspace's checks are gated on
# whether that workspace actually has staged files, so a docs-only commit stays instant.
set -e

repo_root=$(git rev-parse --show-toplevel)
cd "$repo_root"

# GUI git clients start from a minimal PATH that often lacks uv and bun.
PATH="$HOME/.local/bin:$HOME/.bun/bin:/opt/homebrew/bin:/usr/local/bin:$PATH"
export PATH

staged=$(git diff --cached --name-only --diff-filter=ACMR)
[ -n "$staged" ] || exit 0

if printf '%s\n' "$staged" | grep -q '^client/'; then
	echo "── client ────────────────────────────────────────────"
	if command -v bunx >/dev/null 2>&1; then
		(cd client && bunx lint-staged)
	else
		# A bare "bunx: command not found" here reads as a broken hook rather than a missing
		# toolchain, and the usual reaction is --no-verify. Say what to install instead.
		echo "pre-commit: bun is not on PATH, so client checks were skipped." >&2
		echo "            Install bun (https://bun.sh) and run 'bun install' in client/," >&2
		echo "            or commit with --no-verify if you are not touching client code." >&2
		exit 1
	fi
fi

if printf '%s\n' "$staged" | grep -q '^server/'; then
	echo "── server ────────────────────────────────────────────"
	./scripts/pre-commit-server.sh
fi
