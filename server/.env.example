AWS_REGION=us-east-1

# Required, no default. Recent Anthropic models on Bedrock are invocable only through a
# regional *inference profile*, not a bare model ID — a bare ID raises a validation error
# at invoke time rather than at startup. The profile identifier carries a geography prefix
# and is region-specific, so it cannot be hardcoded in the app.
#
# Find the right value for your region:
#     aws bedrock list-inference-profiles --region $AWS_REGION
# then use the `inferenceProfileId` for the model you want. It looks like:
#     us.anthropic.<model-id>
#
# UNVERIFIED: the exact identifier below has not been confirmed against a live account.
# Check it with the command above before deploying.
BEDROCK_MODEL=us.anthropic.claude-opus-5

BEDROCK_MAX_TOKENS=4096

# Local dev only — in production the Lambda execution role supplies these.
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# Optional per-call-site overrides. Unset means both call sites use BEDROCK_MODEL.
# The action fallback runs mid-flow with a return half-driven and a user waiting, so it
# has a tighter latency budget than a parse — see NFR-6.4.
# BEDROCK_MODEL_PARSE=
# BEDROCK_MODEL_ACTION=

# Disposable local PostgreSQL database used only by integration tests.
# Start it with `make test-db-up` and remove it with `make test-db-down`.
# TEST_DATABASE_URL=postgresql+psycopg://boomerang_test:boomerang_test@127.0.0.1:55432/boomerang_test

# ---------------------------------------------------------------------------------------
# Authentication configuration surface (app.config.Settings)
#
# Every value below is required, with no default anywhere in code: an unset value makes
# the process refuse to start rather than fall back to something plausible. All durations
# are a plain integer count of seconds (not an ISO-8601 duration string). These are not
# yet wired into app.main's lifespan — see the dev-note there — so nothing reads them yet.
# The placeholder values below are illustrative starting points, not vetted defaults.
# ---------------------------------------------------------------------------------------

# Credential and grant lifetimes, in seconds.
ACCESS_CREDENTIAL_LIFETIME=900
REFRESH_CREDENTIAL_LIFETIME=2592000
DASHBOARD_ACCESS_CREDENTIAL_LIFETIME=3600

GRANT_IDLE_LIMIT=2592000
GRANT_ABSOLUTE_LIMIT=31536000
# Must equal DASHBOARD_ACCESS_CREDENTIAL_LIFETIME — see app.config's startup validator.
DASHBOARD_GRANT_LIFETIME=3600

# Pairing, in seconds.
PAIRING_LIFETIME=600
PAIRING_POLL_INTERVAL=2

# How long a rotated-out refresh credential still works, in seconds, to absorb a client
# retrying with the credential it had before a rotation it did not yet observe.
REFRESH_ROTATION_GRACE_WINDOW=30

# How often a grant's last_used_at is allowed to go stale before being refreshed, in
# seconds.
LAST_USED_AT_COARSENING_INTERVAL=3600

# OPEN QUESTION — no design document specifies this number; see this ticket's report.
# last_used_at is only refreshed every LAST_USED_AT_COARSENING_INTERVAL, so
# GRANT_IDLE_LIMIT must be comfortably larger than that interval or a grant can be
# evaluated against a stale value. "Comfortably larger" is this ratio, made an explicit,
# named setting instead of a number invented in code. Must be > 1.
COARSENING_INTERVAL_TO_IDLE_LIMIT_RATIO=10

# Rate limits: each a request ceiling and the window (in seconds) it applies over.
PAIRING_CREATION_RATE_LIMIT_COUNT=5
PAIRING_CREATION_RATE_LIMIT_WINDOW=60
PAIRING_REDEMPTION_RATE_LIMIT_COUNT=10
PAIRING_REDEMPTION_RATE_LIMIT_WINDOW=60
REFRESH_RATE_LIMIT_COUNT=20
REFRESH_RATE_LIMIT_WINDOW=60

# Origins and CORS. DASHBOARD_ORIGINS is a comma-separated exact list, never a wildcard —
# one entry per environment (e.g. local dev + staging + production), not a pattern.
# EXTENSION_ORIGIN and API_ORIGIN are single origins. Every dashboard origin must share a
# registrable domain with API_ORIGIN (SameSite=Lax cookie posture depends on it) — see
# app.config's startup validator, which is a best-effort check without a full Public
# Suffix List; see this ticket's report for its known gaps.
DASHBOARD_ORIGINS=https://dashboard.example.com
EXTENSION_ORIGIN=chrome-extension://replace-with-real-extension-id
API_ORIGIN=https://api.example.com
CORS_PREFLIGHT_MAX_AGE=600
